generator client {
  provider = "prisma-client-js"
}

datasource db {
  directUrl = env("DIRECT_URL")
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String
  avatar    String?
  githubId  String?
  tier      String   @default("free")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  designs      Design[]
  simulations  Simulation[]
  reports      SimulationReport[]
  teamMembers  TeamMember[]
  auditLogs    AuditLog[]
  chatSessions ChatSession[]
  chatRequests ChatRequest[]
  generations  Generation[]

  @@map("users")
}

model Team {
  id         String   @id @default(cuid())
  name       String
  description String?
  ownerId    String
  maxMembers Int      @default(5)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members TeamMember[]
  designs Design[]
  invites TeamInvite[]

  @@index([ownerId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      String   @default("member")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model TeamInvite {
  id        String   @id @default(cuid())
  teamId    String   @map("team_id")
  email     String
  role      String   @default("member")
  token     String   @unique
  invitedBy String   @map("invited_by")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@unique([teamId, email])
  @@map("team_invites")
}

model Design {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("draft")
  repoUrl     String?
  repoBranch  String?  @default("main")
  thumbnail   String?
  ownerId     String
  teamId      String?
  // Chat spec §21: every structural modification increments the version.
  // Version is the context-correctness mechanism for design-aware AI chat.
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  team        Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  blocks      Block[]
  edges       Edge[]
  simulations Simulation[]
  reports     SimulationReport[]
  auditLogs   AuditLog[]
  chatSessions ChatSession[]
  generations  Generation[]


  @@index([ownerId])
  @@index([ownerId, updatedAt])
  @@index([teamId])
  @@map("designs")
}

// ============================================================================
// BLOCK MODEL — P6 Batch 2: Denormalized simulation-relevant fields
// Source of truth remains config Json. These fields are extracted for
// queryability, indexing, and fast filtering in list views.
// ============================================================================
model Block {
  id        String   @id @default(cuid())
  designId  String
  type      String
  label     String
  x         Float
  y         Float
  color     String
  config    Json     @default("{}")
  metrics   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- P6 Batch 2: Denormalized simulation fields (extracted from config / behavioralModel) ---
  // Extracted from behavioralModel.scalingBehavior.minReplicas or config.replicas
  replicas  Int?
  // Extracted from config.rateLimit — block-level throttling
  rateLimit Int?
  // Extracted from config.timeout — block-level request timeout (ms)
  timeoutMs Int?
  // Historical metric snapshots for trend analysis and rollback scenarios
  metricsHistory Json?

  design      Design @relation(fields: [designId], references: [id], onDelete: Cascade)
  sourceEdges Edge[] @relation("SourceBlock")
  targetEdges Edge[] @relation("TargetBlock")

  @@index([designId, type])      // Fast filtering by block type within a design
  @@index([designId, replicas])  // Scale-out analysis queries
  @@map("blocks")
}

// ============================================================================
// EDGE MODEL — P6 Batch 2: Denormalized simulation-relevant fields
// Source of truth remains config Json. Extracted for queryability.
// ============================================================================
model Edge {
  id             String  @id @default(cuid())
  designId       String
  sourceId       String
  targetId       String
  connectionType String  @default("http")
  animated       Boolean @default(true)
  label          String?

  // --- P6 Batch 2: Denormalized simulation fields (extracted from behavioralModel) ---
  // Extracted from behavioralModel.throughput.maxRps
  maxRps    Int?
  // Extracted from behavioralModel.reliability.timeoutMs
  timeoutMs Int?
  // Rich edge configuration (behavioralModel, color, icon, description, bandwidth, etc.)
  config    Json?

  design      Design @relation(fields: [designId], references: [id], onDelete: Cascade)
  sourceBlock Block  @relation("SourceBlock", fields: [sourceId], references: [id], onDelete: Cascade)
  targetBlock Block  @relation("TargetBlock", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([designId, connectionType])
  @@map("edges")
}

// ============================================================================
// SIMULATION MODEL — P6 Batch 2: Cost tracking columns
// Top-level cost fields enable SQL sorting/filtering without JSON parsing.
// ============================================================================
model Simulation {
  id             String   @id @default(cuid())
  designId       String
  userId         String

  status         String   @default("running")
  progress       Float    @default(0)
  trafficPattern String   @default("steady")
  rps            Int      @default(100)
  duration       Int      @default(300)
  scenario       String?
  metrics        Json?
  globalMetrics  Json?
  currentRps     Int?
  logs           Json?
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  monteCarloPasses  Int      @default(1)
  confidenceLevel   Float    @default(0.95)
  growthScenario    String?
  generateReport    Boolean  @default(true)
  deterministicSeed Int      @default(0)
  engineVersion     String   @default("1.0.0")
  reportVersion     String   @default("1.0.0")
  inputSnapshot     Json?
  assumptions       Json?
  validationResult  Json?
  confidenceScore   Float    @default(0)
  actualDurationMs  Int?
  errorMessage      String?
  errorStack        String?

  // --- REMOVED (now live only on SimulationReport) ---
  // reliabilityAnalysis Json?
  // scalabilityAnalysis Json?
  // costAnalysis        Json?
  // securityAnalysis    Json?
  // failureScenarios    Json?
  // metricExplanations  Json?

  // --- P6 Batch 2: Top-level cost scalars for SQL filtering ---
  totalSimulatedCost    Float? @default(0)
  projectedMonthlyCost  Float? @default(0)
  projectedAnnualCost   Float? @default(0)

  design   Design             @relation(fields: [designId], references: [id], onDelete: Cascade)
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports  SimulationReport[]
  auditLogs AuditLog[]

  @@index([designId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([designId, status])
  @@index([designId, createdAt])
  @@index([projectedMonthlyCost])
  @@map("simulations")
}

// ============================================================================
// SIMULATION REPORT (New model — permanent structured reports)
// ============================================================================
model SimulationReport {
  id             String   @id @default(cuid())
  simulationId   String   @unique
  designId       String
  userId         String

  version        String   @default("1.0.0")

  overallScore      Int
  architectureScore Int?
  reliabilityScore  Int?
  performanceScore  Int?
  costScore         Int?
  securityScore     Int?
  scalabilityScore  Int?
  confidenceScore   Int?

  executiveSummary    Json
  topologyAnalysis    Json
  performanceAnalysis Json
  reliabilityAnalysis Json
  scalabilityAnalysis Json
  costAnalysis        Json?
  securityAnalysis    Json?
  failureScenarios    Json
  aiInsights          Json?
  actionPlan          Json

  metadata        Json
  generatedAt     DateTime @default(now())

  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  design     Design     @relation(fields: [designId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([designId])
  @@index([userId])
  @@index([generatedAt])
  @@index([designId, generatedAt])  // P5.5: list reports by design
  @@map("simulation_reports")
}

// ============================================================================
// AUDIT LOG — P5.4 Tamper-resistant append-only log
// ============================================================================
model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  designId      String?
  simulationId  String?
  action        String   // e.g. 'simulation_started', 'simulation_completed', 'simulation_failed'
  details       Json     // arbitrary JSON event data
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  design     Design?      @relation(fields: [designId], references: [id], onDelete: SetNull)
  simulation Simulation?  @relation(fields: [simulationId], references: [id], onDelete: SetNull)

  @@index([simulationId])
  @@index([userId])
  @@index([designId])
  @@index([action])
  @@index([createdAt])
  @@index([userId, createdAt])       // P5.5: user audit trail queries
  @@index([simulationId, createdAt]) // P5.5: simulation audit trail queries
  @@map("audit_logs")
}

model OptimizationHistory {
  id           String   @id @default(cuid())
  designId     String
  userId       String
  simulationId String?
  ruleId       String
  ruleName     String
  appliedAt    DateTime @default(now())
  status       String   @default("applying")
  changes      Json?
  error        String?
  rolledBackAt DateTime?

  @@map("optimization_history")
}

// ============================================================================
// CHAT SESSION — Resonance AI Chat (spec §23)
// A conversation. Optionally linked to a design for design-aware context.
// ============================================================================
model ChatSession {
  id       String @id @default(cuid())
  userId   String

  title    String @default("New Chat")

  designId String?
  mode     String @default("general")
  status   String @default("active")

  // Bumped on every completed exchange — used to invalidate client-side state.
  version  Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  design   Design?   @relation(fields: [designId], references: [id], onDelete: SetNull)

  messages ChatMessage[] @relation("SessionMessages")
  requests ChatRequest[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([designId])
  @@index([status, userId])
  @@map("chat_sessions")
}

// ============================================================================
// CHAT MESSAGE — persisted turns (spec §24)
// Ordering uses an explicit per-session `sequence` (never timestamps).
// ============================================================================
model ChatMessage {
  id             String   @id @default(cuid())
  sessionId      String

  sequence       Int

  role           String // 'user' | 'assistant' | 'system'
  content        String   @db.Text
  type           String   @default("text") // 'text' | 'generation' | 'error' | 'system'

  requestId      String?
  idempotencyKey String?

  status         String   @default("completed") // 'pending' | 'streaming' | 'completed' | 'failed'

  metadata       Json?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  session ChatSession @relation("SessionMessages", fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
  @@index([sessionId, createdAt])
  @@index([requestId])
  @@map("chat_messages")
}

// ============================================================================
// CHAT REQUEST — durable state machine for every AI operation (spec §25)
// created -> processing -> streaming -> completed | failed | cancelled
// ============================================================================
model ChatRequest {
  id             String @id @default(cuid())
  idempotencyKey String
  userId         String
  sessionId      String

  status String // processing | completed | failed | cancelled

  messageId  String? // originating user message
  responseId String? // persisted assistant message once completed

  attempt Int @default(1)

  errorCode    String?
  errorMessage String?
  metadata     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([sessionId, status])
  @@map("chat_requests")
}

// ============================================================================
// GENERATION — durable design-generation job state (spec §26)
// queued -> running -> validating -> saving -> completed
// ============================================================================
model Generation {
  id        String @id @default(cuid())

  userId    String
  sessionId String?
  designId  String?

  prompt    String @db.Text

  status String // queued | running | validating | saving | completed | failed | cancelled

  requestKey String?

  designVersion Int?

  errorCode   String?
  errorMessage String?

  // Snapshot of the validated design payload so the generation card can be
  // re-rendered from durable state even if SSE was lost (spec §90).
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  design  Design?  @relation(fields: [designId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([status])
  @@map("generations")
}