{
  "name": "resonance",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web",
    "lint": "eslint apps/*/src --ext .js,.jsx",
    "lint:fix": "eslint apps/*/src --ext .js,.jsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md}\"",
    "clean": "rm -rf apps/*/node_modules packages/*/node_modules node_modules apps/web/dist",
    "test": "echo Tests coming in Phase 2",
    "typecheck": "echo TypeScript coming in Phase 2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.2.0"
  }
}